{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "tenaza", "args": ["hook", "claude"] }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "tenaza", "args": ["hook", "claude"] }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v tenaza >/dev/null 2>&1 || { printf '%s' '{\"systemMessage\":\"Tenaza guardrail OFF — binary not found\"}'; exit 0; }; exec tenaza hook claude",
            "timeout": 240
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "command": "tenaza", "args": ["hook", "claude"] }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "tenaza", "args": ["hook", "claude"] }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "tenaza", "args": ["hook", "claude"] }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "tenaza", "args": ["hook", "claude"] }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "tenaza", "args": ["hook", "claude"] }]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [{ "type": "command", "command": "tenaza", "args": ["hook", "claude"] }]
      }
    ]
  }
}
